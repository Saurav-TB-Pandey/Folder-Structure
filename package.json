{
  "name": "ai_visor",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "swagger": "node ./src/swagger/index.js",
    "dev": "(lsof -t -i:8080 | xargs -r kill -9) && nodemon -r dotenv/config --experimental-json-modules src/server.js dotenv_config_path=.env.local",
    "staging": "(lsof -t -i:4029 | xargs -r kill -9) && node -r dotenv/config --experimental-json-modules src/server.js dotenv_config_path=.env.staging",
    "start": "(lsof -t -i:8082 | xargs -r kill -9) && node -r dotenv/config --experimental-json-modules src/server.js dotenv_config_path=.env.production"
  },
  "author": "Saurav Pandey",
  "license": "ISC",
  "description": "This is a website.",
  "type": "module",
  "dependencies": {
    "axios": "^1.8.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "fs": "^0.0.1-security",
    "helmet": "^8.0.0",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "joi": "^17.13.3",
    "joi-objectid": "^4.0.2",
    "logger": "^0.0.1",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "sequelize": "^6.37.5",
    "swagger-ui-express": "^5.0.1",
    "url": "^0.11.4",
    "winston": "^3.16.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "swagger-autogen": "^2.23.7"
  }
