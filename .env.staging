# Application Configuration
PORT=4000
MONGODB_URI=your_mongodb_uri/
DB_NAME=your_db_name

# Token Secrets (use strong, unique, randomly generated secrets)
ACCESS_TOKEN_SECRET=staging_access_token_secret_very_long_and_random
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_SECRET=staging_refresh_token_secret_very_long_and_random
REFRESH_TOKEN_EXPIRY=7d
RESET_PASSWORD_TOKEN_SECRET=staging_reset_password_token_secret_very_long_and_random
RESET_PASSWORD_TOKEN_EXPIRY=1h

# Security
ENCRYPTION_KEY=staging_encryption_key_very_long_and_random
SALT_WORK_FACTOR=12

# Environment
NODE_ENV=staging

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL=your_staging_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_CIPHERS=SSLv3
EMAIL_REJECT_UNAUTHORIZED=true


# Claudinary Configuration
CLAUDINARY_CLOUD_NAME= your_claudinary_cloud_name
CLAUDINARY_API_KEY = your_claudinary_api_key
CLAUDINARY_API_SECRET = your_claudinary_api_secret